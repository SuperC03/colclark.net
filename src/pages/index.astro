---
import BaseLayout from "../layout/base.astro";
import Link from "../components/link.astro";

import { home } from "../json-schema";
---

<style>
  .intro-text {
    margin: var(--space-s) auto;
  }

  .digest-row {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
  }

  .digest-row > div {
    flex-grow: 1;
    text-align: center;
  }

  header,
  section {
    margin: var(--space-m) auto;
  }
</style>

<BaseLayout
  title="Engineering & Miscellany"
  description="I build hardware and software, from circuit boards to the code that runs on them. I'm trying to write more about things I find interesting."
  jsonSchema={home()}
>
  <header class="wrapper-narrow">
    <h2>Welcome</h2>
    <p class="prose intro-text">
      Hi! I'm Colin, an engineer interested in power electronics, signal
      processing, and physics. I'm researching Low Energy Nuclear Reactions with <Link
        href="https://florianmetzler.com"
        external
      >
        Florian Metzler</Link
      > and <Link href="https://duhanzhang.com" external>Duhan Zhang</Link> under
      Principal Investigator <Link
        href="https://www.rle.mit.edu/people/peter-l-hagelstein/"
        external>Peter Hagelstein</Link
      >. I also develop satellite communication systems at <Link
        href="https://www.mithril.space/"
        external>Mithril Space</Link
      >. I also<sup>2</sup> work on computational infrastructure for <Link
        href="https://www.oligospace.com/"
        external>Oligo Space</Link
      >.
    </p>
    <p>
      This website is a work in progress, please excuse any unfinished sections.
    </p>
  </header>
  <section class="wrapper digest-row">
    <div>
      <h2>Projects</h2>
      <p>Coming soon...</p>
      <!-- <a href="/projects">See More</a> -->
    </div>
    <div>
      <h2>Writings</h2>
      <p>Coming soon...</p>
      <!-- <a href="/posts">See More</a> -->
    </div>
  </section>
</BaseLayout>
